# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Player logins (client-side) ─────────────────────────────────────────────
# This is a private two-player app: the login screen has one button per player
# and signs in with the credentials below via Supabase email/password auth.
# Create both users in Supabase Dashboard → Authentication → Users first.
#
# SECURITY NOTE: anything prefixed with VITE_ is embedded in the shipped bundle
# and is therefore readable by anyone with the app. Only use throwaway
# credentials for accounts that exist solely in this private two-person world,
# and rely on Row-Level Security (already enforced) to scope each user's data.
VITE_PIBBLE_EMAIL=pibble@example.com
VITE_PIBBLE_PASSWORD=change-me
VITE_NIBBLE_EMAIL=nibble@example.com
VITE_NIBBLE_PASSWORD=change-me

# ─── Anthropic (server-side only) ────────────────────────────────────────────
# Used exclusively inside the Supabase Edge Function `generate-build`.
# NEVER prefix this with VITE_ — it must not be exposed to the browser.
# Set it as a Supabase secret: `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`
# Individual users can also supply their own key in Settings → AI Provider (BYOK).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Gemini fallback (server-side only) ──────────────────────────────────────
# Used by the `generate-build` Edge Function when Claude is unavailable.
# NEVER prefix with VITE_.
GEMINI_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
# Desktop builds run under the Tauri custom scheme (tauri://localhost on macOS,
# http://tauri.localhost on Windows), so auth redirect URLs are not used.
# Left here only for `npm run dev` in a browser during UI work.
VITE_APP_URL=http://localhost:1420
